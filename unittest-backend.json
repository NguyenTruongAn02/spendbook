{
    "info": {
        "_postman_id": "spendbook-api-collection",
        "name": "SpendBook API (Express + TS, Port 4000)",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "base_url",
            "value": "http://localhost:4000/api"
        },
        {
            "key": "email",
            "value": "test_spendbook@example.com"
        },
        {
            "key": "password",
            "value": "123456"
        },
        {
            "key": "token",
            "value": ""
        },
        {
            "key": "walletId",
            "value": ""
        },
        {
            "key": "categoryId",
            "value": ""
        },
        {
            "key": "transactionId",
            "value": ""
        }
    ],
    "item": [
        {
            "name": "Health Check",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{base_url}}/",
                    "host": [
                        "{{base_url}}"
                    ]
                }
            }
        },
        {
            "name": "Auth",
            "item": [
                {
                    "name": "Google Login",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"idToken\": \"{{google_id_token}}\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/auth/google",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "auth",
                                "google"
                            ]
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "var json = pm.response.json();",
                                    "if (json.data && json.data.token) { pm.collectionVariables.set(\"token\", json.data.token); }"
                                ]
                            }
                        }
                    ]
                }
            ]
        },
        {
            "name": "Categories",
            "item": [
                {
                    "name": "Create Category",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"name\": \"Ăn uống\",\n  \"type\": \"EXPENSE\",\n  \"icon\": \"🍔\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/categories",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "categories"
                            ]
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "var json = pm.response.json();",
                                    "if (json.data && json.data._id) { pm.collectionVariables.set(\"categoryId\", json.data._id); }"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Get Categories",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/categories",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "categories"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "Wallets",
            "item": [
                {
                    "name": "Create Wallet",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"name\": \"Ví tiền mặt\", \n  \"bankName\": \"Tiền mặt\", \n  \"accountNumber\": \"\", \n  \"startDate\": \" 2025-02-17\", \n  \"openingBalance\": 2000000\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/wallets",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "wallets"
                            ]
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "var json = pm.response.json();",
                                    "if (json.data && json.data._id) { pm.collectionVariables.set(\"walletId\", json.data._id); }"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Get Wallets",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/wallets",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "wallets"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "Transactions",
            "item": [
                {
                    "name": "Create Transaction",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"walletId\": \"{{walletId}}\",\n  \"categoryId\": \"{{categoryId}}\",\n  \"type\": \"EXPENSE\",\n  \"amount\": 45000,\n  \"note\": \"Uống cà phê\",\n  \"date\": \"2025-02-20\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/transactions",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "transactions"
                            ]
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "var json = pm.response.json();",
                                    "if (json.data && json.data._id) { pm.collectionVariables.set(\"transactionId\", json.data._id); }"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Get Transactions",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/transactions?page=1&limit=20",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "transactions"
                            ],
                            "query": [
                                {
                                    "key": "page",
                                    "value": "1"
                                },
                                {
                                    "key": "limit",
                                    "value": "20"
                                }
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "Reports",
            "item": [
                {
                    "name": "Monthly Report",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/reports/monthly?month=2&year=2025",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "reports",
                                "monthly"
                            ],
                            "query": [
                                {
                                    "key": "month",
                                    "value": "2"
                                },
                                {
                                    "key": "year",
                                    "value": "2025"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "Summary Report",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/reports/summary",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "reports",
                                "summary"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "Excel",
            "item": [
                {
                    "name": "Export Excel",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/excel/export",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "excel",
                                "export"
                            ]
                        }
                    }
                }
            ]
        }
    ]
}